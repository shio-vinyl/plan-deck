#!/usr/bin/env python3
"""不安装也能用：<有 python-pptx、pillow 的 Python> <plan-deck 仓库>/bin/plan-deck ...。"""
import os
import sys

for stream in (sys.stdout, sys.stderr):  # JSON and messages are UTF-8 everywhere, not the Windows code page
    stream.reconfigure(encoding='utf-8', errors='backslashreplace')

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, 'src'))

try:
    from plan_deck.cli import main  # noqa: E402
except ModuleNotFoundError as e:
    if e.name not in ('pptx', 'PIL'):
        raise
    venv = os.path.join(ROOT, '.venv', 'Scripts', 'python.exe') if os.name == 'nt' else os.path.join(ROOT, '.venv', 'bin', 'python')
    hint = (f'改用 {venv} 运行' if os.path.isfile(venv)
            else f'在 {ROOT} 建虚拟环境并安装依赖（pip install -e .），再用它的 Python 运行，见 README“运行环境”')
    sys.exit(f'plan-deck：{sys.executable} 缺依赖 {e.name}。{hint}')

sys.exit(main())
